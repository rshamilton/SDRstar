+// SDRstar: pull one audio block out of the ring WITHOUT ever waiting for data that may not come.
+//
+// Upstream the audio callback calls RingBuffer::read(), which blocks until the whole block is there.  With a single
+// stream that is harmless, but SDRstar adds a second stream ("SDRstar Voice") that is silent until a call is decoded,
+// and CoreAudio runs every stream that shares an output device on ONE I/O thread.  A callback that sits waiting for a
+// silent stream therefore stalls the other stream too, and anything that stops, reopens or reconfigures the device (a
+// click in the Sinks menu) then waits for that blocked thread: the whole application freezes until a call happens to
+// arrive.  So: take what is there; wait only briefly for the rest of a block that has already started; and fill what is
+// missing with silence.  A stream that has nothing queued costs nothing.
+template <class T>
+static void sdrstarPull(dsp::buffer::RingBuffer<T>& rb, T* out, unsigned long frames, double sampleRate) {
+    const double blockMs = 1000.0 * (double)frames / (sampleRate > 0 ? sampleRate : 48000.0);
+    const double waitMs = std::max(1.0, std::min(8.0, 0.4 * blockMs));
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::microseconds((long long)(waitMs * 1000.0));
+    unsigned long done = 0;
+    while (done < frames) {
+        const int avail = rb.getReadable();
+        if (avail <= 0) {
+            if (done == 0 || std::chrono::steady_clock::now() >= deadline) { break; }
+            std::this_thread::sleep_for(std::chrono::microseconds(200));
+            continue;
+        }
+        const int n = (int)std::min<unsigned long>((unsigned long)avail, frames - done);
+        if (rb.read(out + done, n) < 0) { break; }   // the sink is being stopped
+        done += (unsigned long)n;
+    }
+    if (done < frames) { memset(out + done, 0, (frames - done) * sizeof(T)); }
+}
