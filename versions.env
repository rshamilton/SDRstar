# SDRstar pinned upstream versions.  Everything the build downloads is pinned to an exact commit so a build
# today and a build in a year produce the same app.  To upgrade a component: change the SHA, rebuild, run the tests.

# SDR++ v1.3.0 base (GPL-3.0) -- the GUI, waterfall, VFOs, RTL-SDR source, audio, recorder ...
SDRPP_REPO=https://github.com/AlexandreRouma/SDRPlusPlus
SDRPP_SHA=8c9f5ee8fe405775bfcd62c8c8f8c0fc928a64af

# DSD-neo (GPL-3.0): digital voice + control-channel decoder (P25 P1/P2, DMR, NXDN, D-STAR, YSF, dPMR, EDACS, ProVoice, M17)
DSDNEO_REPO=https://github.com/arancormonk/dsd-neo
DSDNEO_SHA=782e629ec63b56268c95d5cb58aae5e74e0aefbd
# mbelib-neo (GPL-2.0-or-later): IMBE/AMBE vocoder used by DSD-neo (see patent notice in THIRD_PARTY.md)
MBELIB_NEO_REPO=https://github.com/arancormonk/mbelib-neo
MBELIB_NEO_SHA=fae6f38da48b56e284375b174537ad8beb7b5eba

# librtlsdr 2.0.3 (GPL-2.0-or-later): includes native RTL-SDR Blog V4 / V4L support (HF upconverter, bias tee GPIO)
RTLSDR_REPO=https://github.com/osmocom/rtl-sdr
RTLSDR_SHA=797f8143266d983c56d8f35d2d442527529dd8a5

# Other helper decoders (GPL-2.0): pagers/AFSK/DTMF/EAS and 433/868/915 MHz ISM sensors
MULTIMON_REPO=https://github.com/EliasOenal/multimon-ng
MULTIMON_TAG=1.6.2
MULTIMON_SHA=0722194b7739748e49f18ac1fc76f236d4ca390d
RTL433_REPO=https://github.com/merbanan/rtl_433
RTL433_TAG=25.12
RTL433_SHA=ea7d504877df751a202432d47dbb0c425ab0a93c

# Libraries SDR++ needs that Homebrew's current version may drift on
VOLK_REPO=https://github.com/gnuradio/volk
VOLK_TAG=v3.2.0
VOLK_SHA=1c2fe1a762728e7c5008dd5d9497e39c0702c78e
LIBUSB_TAG=v1.0.29

# Minimum macOS the app is built for.
MACOS_DEPLOYMENT_TARGET=12.0
