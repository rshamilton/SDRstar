# SPDX-License-Identifier: GPL-3.0-or-later
#
# Extra pins for the macOS build: everything the native dependency stage needs that versions.env does not already
# pin (versions.env remains the single source of truth for SDR++, DSD-neo, mbelib-neo, librtlsdr, multimon-ng,
# rtl_433, VOLK, libusb's tag and MACOS_DEPLOYMENT_TARGET).
#
# Rules
#   * git sources are pinned to a full COMMIT sha (not an annotated-tag object sha); the fetch helper verifies it.
#   * tarball sources are pinned to a SHA-256; a mismatch stops the build.
#   * To bump a dependency: change the version/sha here, rebuild, run the checks.  Because the CI dependency cache
#     is keyed on a hash of this file, a bump automatically rebuilds only what the cache key covers (everything in
#     .deps/<arch>) -- see docs/MAC_BUILD.md.

# --- libusb (LGPL-2.1+): tag comes from versions.env (LIBUSB_TAG); the release tarball ships a ready ./configure
LIBUSB_SHA256=5977fc950f8d1395ccea9bd48c06b3f808fd3c2c961b44b0c2e6e29fc3a70a85

# --- FFTW 3.3.10, single precision + threads (GPL-2.0+)
FFTW_VERSION=3.3.10
FFTW_URL=https://www.fftw.org/fftw-3.3.10.tar.gz
FFTW_SHA256=56c932549852cddcfafdab3820b0200c7742675be92179e59e6215b340e26467

# --- GLFW 3.4 (zlib): window / OpenGL context for SDR++
GLFW_REPO=https://github.com/glfw/glfw
GLFW_TAG=3.4
GLFW_SHA=7b6aead9fb88b3623e3b3725ebb42670cbe4c579

# --- zstd 1.5.7 (BSD/GPLv2): SDR++ server-mode compression
ZSTD_REPO=https://github.com/facebook/zstd
ZSTD_TAG=v1.5.7
ZSTD_SHA=f8745da6ff1ad1e7bab384bd1f9d742439278e99

# --- PortAudio 19.7.0 (MIT): audio output for SDR++ (CoreAudio host API)
PORTAUDIO_REPO=https://github.com/PortAudio/portaudio
PORTAUDIO_TAG=v19.7.0
PORTAUDIO_SHA=147dd722548358763a8b649b3e4b41dfffbcfbb6

# --- libsndfile 1.2.2 (LGPL-2.1+): WAV output used by DSD-neo (built without the optional Ogg/FLAC/Opus/MPEG libs)
LIBSNDFILE_REPO=https://github.com/libsndfile/libsndfile
LIBSNDFILE_TAG=1.2.2
LIBSNDFILE_SHA=72f6af15e8f85157bd622ed45b979025828b7001

# --- OpenSSL 3.5 LTS (Apache-2.0): DSD-neo requires OpenSSL >= 3.0 (macOS ships LibreSSL, which does not qualify)
OPENSSL_VERSION=3.5.9
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

# --- Codec2 (LGPL-2.1): M17 voice in DSD-neo.  Same fork+commit DSD-neo's own macOS CI pins (tools/ci-dependency-pins.env)
CODEC2_REPO=https://github.com/arancormonk/codec2
CODEC2_SHA=ad5e23bfdf93896a7344e06a5ff65aa76bcc5a44

# --- Mako (MIT): python template engine VOLK needs at build time to generate its kernels.  Installed ONLY into the
#     repo-local virtualenv .deps/venv, never globally.
MAKO_VERSION=1.3.10
